<div class="container">
    <h1>Past Events</h1>

    <form method="GET" action="/events/archive" style="margin-bottom: 1rem;">
        <input type="text" name="category" placeholder="Filter by category" />
        <button type="submit">Filter</button>
    </form>

  <% if (pageError) { %>
    <div class="error-box">
      <p><%= pageError %></p>
    </div>
  <% } %>

  <% if (events.length === 0) { %>
    <p class="empty">No past events.</p>
  <% } else { %>
    <div class="event-list">
      <% events.forEach(event => { %>
        <div class="event-card">
          
          <div class="event-header">
            <h2><%= event.title %></h2>
            <span class="badge">Past</span>
          </div>

          <div class="event-details">
            <p><strong>Location:</strong> <%= event.location %></p>
            <p><strong>Category:</strong> <%= event.category %></p>
          </div>

          <div class="event-time">
            <p>
              <%= event.startDatetime.toLocaleString() %> 
              → 
              <%= event.endDatetime.toLocaleString() %>
            </p>
          </div>

          <div class="event-actions">
            <a href="/events/<%= event.id %>" class="btn">View Details</a>
          </div>

        </div>
      <% }) %>
    </div>
  <% } %>
</div>