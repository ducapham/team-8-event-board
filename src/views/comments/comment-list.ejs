<%# Feature 13 — Event Comments partial (rendered with layout: false for HTMX) %>
<section id="comments-section" class="mt-8">
  <h2 class="text-lg font-semibold text-slate-800 mb-4">Comments</h2>

  <%# Comment list %>
  <div id="comment-list" class="space-y-3 mb-6">
    <% if (comments.length === 0) { %>
      <p class="text-sm text-slate-500 italic">No comments yet. Be the first to comment!</p>
    <% } else { %>
      <% comments.forEach(function(comment) { %>
        <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
          <div class="flex items-center justify-between mb-1">
            <span class="text-sm font-semibold text-slate-800"><%= comment.authorName %></span>
            <span class="text-xs text-slate-400"><%= comment.createdAt.toLocaleString() %></span>
          </div>
          <p class="text-sm text-slate-700"><%= comment.content %></p>
          <%# Delete button — submitted via HTMX, swaps back the updated list %>
          <form
            hx-post="/events/<%= eventId %>/comments/<%= comment.id %>/delete"
            hx-target="#comments-section"
            hx-swap="outerHTML"
            class="mt-2 m-0"
          >
            <button
              type="submit"
              class="text-xs text-red-500 hover:text-red-700 underline bg-transparent border-0 cursor-pointer p-0"
            >
              Delete
            </button>
          </form>
        </div>
      <% }); %>
    <% } %>
  </div>

  <%# Post a new comment form (HTMX) %>
  <form
    hx-post="/events/<%= eventId %>/comments"
    hx-target="#comments-section"
    hx-swap="outerHTML"
    class="flex flex-col gap-2"
  >
    <label for="comment-content" class="text-sm font-medium text-slate-700">
      Add a comment
    </label>
    <textarea
      id="comment-content"
      name="content"
      rows="3"
      placeholder="Write your comment here…"
      class="w-full rounded-xl border border-slate-300 px-3 py-2 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-blue-400 resize-none"
    ></textarea>
    <button
      type="submit"
      class="self-end rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700"
    >
      Post Comment
    </button>
  </form>
</section>
