<%# Feature 12 — Attendee List
     `compact = true` is set when this template is rendered as an HTMX
     partial inside the event detail page; the parent already shows the
     event title, so we drop the duplicate header in that case. %>
<% const isCompact = typeof compact !== "undefined" && compact === true; %>

<div class="<%= isCompact
      ? "rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
      : "max-w-3xl mx-auto rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10" %>">

  <% if (!isCompact) { %>
    <p class="text-xs font-semibold uppercase tracking-wide text-blue-600 mb-2">
      Feature 12 — Attendee List
    </p>
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-1"><%= eventTitle %></h1>
    <p class="text-slate-400 text-sm mb-8">Event #<%= eventId %></p>
  <% } else { %>
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-base sm:text-lg font-semibold text-slate-900">
        Attendees
      </h2>
      <p class="text-xs uppercase tracking-wide text-slate-400">
        <%= grouped.going.length + grouped.waitlisted.length + grouped.cancelled.length %> total
      </p>
    </div>
  <% } %>

  <%
    // Status group config — palette matches the team's status pills on the
    // event list page (emerald / amber / rose).
    const groups = [
      {
        label: "Going",
        key: "going",
        pillBg: "bg-emerald-100",
        pillText: "text-emerald-700",
        ringClass: "ring-emerald-200",
        rowAccent: "border-l-emerald-400",
        icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5"><path fill-rule="evenodd" d="M16.704 5.296a1 1 0 0 1 0 1.414l-7.5 7.5a1 1 0 0 1-1.414 0l-3.5-3.5a1 1 0 1 1 1.414-1.414l2.793 2.793 6.793-6.793a1 1 0 0 1 1.414 0Z" clip-rule="evenodd"/></svg>',
      },
      {
        label: "Waitlisted",
        key: "waitlisted",
        pillBg: "bg-amber-100",
        pillText: "text-amber-700",
        ringClass: "ring-amber-200",
        rowAccent: "border-l-amber-400",
        icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5"><path fill-rule="evenodd" d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm.75 4.25a.75.75 0 0 0-1.5 0V10c0 .2.08.39.22.53l2.25 2.25a.75.75 0 1 0 1.06-1.06l-2.03-2.03V6.25Z" clip-rule="evenodd"/></svg>',
      },
      {
        label: "Cancelled",
        key: "cancelled",
        pillBg: "bg-rose-100",
        pillText: "text-rose-700",
        ringClass: "ring-rose-200",
        rowAccent: "border-l-rose-400",
        icon: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm-2.78-9.22a.75.75 0 0 1 1.06 0L10 10.44l1.72-1.72a.75.75 0 1 1 1.06 1.06L11.06 11.5l1.72 1.72a.75.75 0 0 1-1.06 1.06L10 12.56l-1.72 1.72a.75.75 0 0 1-1.06-1.06L8.94 11.5 7.22 9.78a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/></svg>',
      },
    ];

    // Format helper: relative-ish time (e.g. "Apr 28, 6:00 PM"). The raw
    // value is a Date from the service layer.
    function fmtWhen(d) {
      const date = d instanceof Date ? d : new Date(d);
      return date.toLocaleString(undefined, {
        month: "short", day: "numeric", hour: "numeric", minute: "2-digit",
      });
    }
  %>

  <div class="space-y-6">
    <% for (const group of groups) { %>
      <% const items = grouped[group.key]; %>
      <section>
        <%# Section header: pill with inline count + secondary label.
            Keep `Going (N)` / `Waitlisted (N)` / `Cancelled (N)` adjacent so
            the existing HTTP contract regexes still match. %>
        <div class="flex items-center justify-between mb-3">
          <span class="inline-flex items-center gap-1.5 rounded-full <%= group.pillBg %> <%= group.pillText %> px-3 py-1 text-xs font-semibold uppercase tracking-wide ring-1 <%= group.ringClass %>">
            <%- group.icon %>
            <%= group.label %> (<%= items.length %>)
          </span>
          <span class="text-xs font-medium text-slate-400">
            <%= items.length === 1 ? "1 attendee" : items.length + " attendees" %>
          </span>
        </div>

        <% if (items.length === 0) { %>
          <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50/60 px-4 py-3 text-xs text-slate-400 italic">
            No attendees in this group.
          </p>
        <% } else { %>
          <ul class="divide-y divide-slate-100 overflow-hidden rounded-2xl border border-slate-200 bg-white">
            <% for (const attendee of items) { %>
              <%# Per-row left accent stripe in the group color %>
              <li class="flex items-center justify-between gap-3 border-l-4 <%= group.rowAccent %> bg-white px-4 py-3 hover:bg-slate-50 transition">
                <div class="flex items-center gap-3 min-w-0">
                  <%# Initials avatar %>
                  <div class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-slate-100 text-xs font-semibold text-slate-600">
                    <%= (attendee.displayName || "?").trim().split(/\s+/).map(p => p[0]).slice(0, 2).join("").toUpperCase() %>
                  </div>
                  <p class="truncate text-sm font-medium text-slate-800">
                    <%= attendee.displayName %>
                  </p>
                </div>
                <span class="flex-none text-xs text-slate-400 tabular-nums whitespace-nowrap">
                  <%= fmtWhen(attendee.createdAt) %>
                </span>
              </li>
            <% } %>
          </ul>
        <% } %>
      </section>
    <% } %>
  </div>

  <% if (!isCompact) { %>
    <div class="mt-8">
      <a href="/events/<%= eventId %>" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 hover:underline">
        <span aria-hidden="true">&larr;</span>
        Back to event
      </a>
    </div>
  <% } %>
</div>
