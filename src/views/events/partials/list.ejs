<section class="space-y-6">
  <% if (events.length === 0) { %>
    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 text-center text-slate-600">
      <p class="text-lg font-medium">No events match your search.</p>
      <p class="mt-2 text-sm">Try a different query or remove the filter.</p>
    </div>
  <% } %>

  <% const currentUserId = session?.authenticatedUser?.userId; %>
  <% events.forEach((event) => { %>
    <% const isRegistered = currentUserId ? event.attendees.some((user) => user.id === currentUserId) : false; %>
    <% const isWaitlisted = currentUserId ? event.waitlist.some((user) => user.id === currentUserId) : false; %>
    <article class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div class="space-y-3">
          <div class="flex flex-wrap items-center gap-2 text-slate-500 text-sm">
            <span class="rounded-full bg-slate-100 px-3 py-1">Category: <strong class="text-slate-700"><%= event.category %></strong></span>
            <span class="rounded-full bg-slate-100 px-3 py-1">Location: <strong class="text-slate-700"><%= event.location %></strong></span>
          </div>
          <h2 class="text-2xl font-semibold text-slate-900"><%= event.title %></h2>
          <p class="text-slate-600"><%= event.description %></p>
          <div class="flex flex-wrap gap-3 text-sm text-slate-500">
            <span><strong>Date:</strong> <%= event.date.toDateString() %></span>
            <span><strong>Time:</strong> <%= event.time %></span>
            <span><strong>Capacity:</strong> <%= event.attendees.length %> / <%= event.capacity %></span>
          </div>
        </div>

        <div class="flex flex-col items-start gap-3 text-right sm:items-end">
          <div class="space-x-2 text-sm text-slate-500">
            <% if (isRegistered) { %>
              <span class="rounded-full bg-emerald-100 px-3 py-1 text-emerald-700">Registered</span>
            <% } else if (isWaitlisted) { %>
              <span class="rounded-full bg-amber-100 px-3 py-1 text-amber-700">Waitlisted</span>
            <% } else if (event.attendees.length >= event.capacity) { %>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-slate-700">Full</span>
            <% } else { %>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-slate-700">Open</span>
            <% } %>
          </div>

            <% if (currentUserId) { %>
            <% if (isRegistered) { %>
              <form method="post" action="/events/<%= event.id %>/toggle" class="m-0">
                <button type="submit" class="rounded-2xl bg-red-600 px-4 py-2 text-white font-semibold hover:bg-red-700">Cancel RSVP</button>
              </form>
            <% } else if (isWaitlisted) { %>
              <button type="button" disabled class="rounded-2xl bg-amber-100 px-4 py-2 text-amber-700 font-semibold">Waitlisted</button>
            <% } else { %>
              <form method="post" action="/events/<%= event.id %>/toggle" class="m-0">
                <button type="submit" class="rounded-2xl bg-blue-600 px-4 py-2 text-white font-semibold hover:bg-blue-700">
                  <%= event.attendees.length >= event.capacity ? "Join waitlist" : "RSVP" %>
                </button>
              </form>
            <% } %>
          <% } %>
          <a href="/events/<%= event.id %>" class="inline-flex items-center justify-center rounded-2xl bg-slate-900 px-4 py-2 text-white font-semibold hover:bg-slate-800">
            View details
          </a>
        </div>
      </div>
    </article>
  <% }) %>
</section>
