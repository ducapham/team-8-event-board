<section
  class="rounded-3xl border border-slate-200 bg-white p-6 shadow-lg"
  x-data="{
    category: '<%= (filters.category ?? '').replace(/'/g, "\\'") %>',
    timeframe: '<%= (filters.timeframe ?? 'all-upcoming').replace(/'/g, "\\'") %>',
    hasActiveFilters() {
      return this.category !== '' || this.timeframe !== 'all-upcoming';
    },
    clearFilters() {
      this.category = '';
      this.timeframe = 'all-upcoming';
      this.$nextTick(() => this.$refs.filterForm.requestSubmit());
    }
  }"
>
  <form
    x-ref="filterForm"
    method="get"
    action="/events"
    class="space-y-4"
    hx-get="/events"
    hx-target="#eventList"
    hx-swap="innerHTML"
    hx-push-url="true"
  >
    <input type="hidden" name="query" value="<%= query ?? "" %>" />
    <input type="hidden" name="category" :value="category" />
    <input type="hidden" name="timeframe" :value="timeframe" />

    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="space-y-3">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Filter Events</p>

        <div class="flex flex-col gap-3 xl:flex-row xl:items-center">
          <div class="flex flex-col gap-2">
            <span class="text-sm font-medium text-slate-700">Category</span>
            <div class="flex flex-wrap gap-2 rounded-2xl bg-slate-100 p-2">
              <button
                type="button"
                @click="category = ''"
                class="min-w-[6.75rem] rounded-xl px-3.5 py-2 text-center text-sm font-medium transition"
                :class="category === '' ? 'bg-slate-900 text-white shadow-sm ring-2 ring-slate-200' : 'bg-white text-slate-600 hover:bg-slate-200'"
              >
                All
              </button>
              <% categories.forEach((category) => { %>
                <button
                  type="button"
                  @click="category = '<%= category %>'"
                  class="min-w-[6.75rem] rounded-xl px-3.5 py-2 text-center text-sm font-medium transition"
                  :class="category === '<%= category %>' ? 'bg-blue-600 text-white shadow-sm ring-2 ring-blue-100' : 'bg-white text-slate-600 hover:bg-slate-200'"
                >
                  <%= category.charAt(0).toUpperCase() + category.slice(1) %>
                </button>
              <% }) %>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <span class="text-sm font-medium text-slate-700">Timeframe</span>
            <div class="flex flex-wrap gap-2 rounded-2xl bg-slate-100 p-2">
              <% timeframes.forEach((timeframe) => { %>
                <button
                  type="button"
                  @click="timeframe = '<%= timeframe %>'"
                  class="min-w-[6.75rem] rounded-xl px-3.5 py-2 text-center text-sm font-medium transition"
                  :class="timeframe === '<%= timeframe %>' ? 'bg-emerald-600 text-white shadow-sm ring-2 ring-emerald-100' : 'bg-white text-slate-600 hover:bg-slate-200'"
                >
                  <%= timeframe.replace(/-/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()) %>
                </button>
              <% }) %>
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <button
          type="button"
          @click="clearFilters()"
          class="min-w-[7.75rem] rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-600 transition duration-150 hover:border-slate-400 hover:text-slate-900"
          :class="hasActiveFilters() ? 'visible translate-y-0 opacity-100' : 'pointer-events-none invisible translate-y-1 opacity-0'"
        >
          Clear filters
        </button>

        <button
          type="submit"
          class="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800"
        >
          Apply filters
        </button>
      </div>
    </div>
  </form>
</section>