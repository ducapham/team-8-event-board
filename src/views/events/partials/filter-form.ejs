<section
  class="rounded-3xl border border-slate-200 bg-white p-6 shadow-lg"
  x-data="{
    category: <%- JSON.stringify(filters.category ?? '') %>,
    timeframe: <%- JSON.stringify(filters.timeframe ?? 'all-upcoming') %>,
    hasActiveFilters() {
      return this.category !== '' || this.timeframe !== 'all-upcoming';
    },
    clearFilters() {
      this.category = '';
      this.timeframe = 'all-upcoming';
      htmx.ajax('GET', '/events?timeframe=all-upcoming&query=<%= encodeURIComponent(query ?? '') %>', {
        target: '#eventList',
        swap: 'innerHTML',
        pushURL: true,
      });
    }
  }"
>
  <form
    method="get"
    action="/events"
    class="space-y-4"
    hx-get="/events"
    hx-target="#eventList"
    hx-swap="innerHTML"
    hx-push-url="true"
  >
    <input type="hidden" name="query" value="<%= query ?? "" %>" />

    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="space-y-3">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Filter Events</p>

        <div class="flex flex-col gap-3 xl:flex-row xl:items-center">
          <div class="flex flex-col gap-2">
            <span class="text-sm font-medium text-slate-700">Category</span>
            <div class="flex flex-wrap gap-2 rounded-2xl bg-slate-100 p-2">
              <button
                type="submit"
                name="category"
                value=""
                @click="category = ''"
                class="rounded-xl px-4 py-2 text-sm font-medium transition"
                :class="category === '' ? 'bg-slate-900 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-200'"
              >
                All
              </button>
              <% categories.forEach((category) => { %>
                <button
                  type="submit"
                  name="category"
                  value="<%= category %>"
                  @click="category = '<%= category %>'"
                  class="rounded-xl px-4 py-2 text-sm font-medium transition"
                  :class="category === '<%= category %>' ? 'bg-blue-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-200'"
                >
                  <%= category.charAt(0).toUpperCase() + category.slice(1) %>
                </button>
              <% }) %>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <span class="text-sm font-medium text-slate-700">Timeframe</span>
            <div class="flex flex-wrap gap-2 rounded-2xl bg-slate-100 p-2">
              <% timeframes.forEach((timeframe) => { %>
                <button
                  type="submit"
                  name="timeframe"
                  value="<%= timeframe %>"
                  @click="timeframe = '<%= timeframe %>'"
                  class="rounded-xl px-4 py-2 text-sm font-medium transition"
                  :class="timeframe === '<%= timeframe %>' ? 'bg-emerald-600 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-200'"
                >
                  <%= timeframe.replace(/-/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()) %>
                </button>
              <% }) %>
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <button
          type="button"
          x-show="hasActiveFilters()"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0 translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-1"
          @click="clearFilters()"
          class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-600 hover:border-slate-400 hover:text-slate-900"
        >
          Clear filters
        </button>

        <button
          type="submit"
          class="rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800"
        >
          Apply filters
        </button>
      </div>
    </div>
  </form>
</section>