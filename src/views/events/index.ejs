<section class="mb-6 p-6 border border-slate-200 rounded-3xl bg-white shadow-lg">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold text-slate-900">Events</h1>
      <p class="mt-2 text-slate-600">Browse upcoming events and RSVP directly from the list.</p>
    </div>

    <div class="w-full sm:w-[320px]">
      <label class="block text-sm font-medium text-slate-700 mb-2" for="event-search">Search events</label>
      <input
        id="event-search"
        name="query"
        type="search"
        value=""
        placeholder="Search by title, location, or category"
        class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-900 outline-none focus:border-blue-400 focus:ring-4 focus:ring-blue-100"
        hx-get="/events/search"
        hx-trigger="keyup changed delay:250ms"
        hx-target="#eventList"
        hx-swap="innerHTML"
      />
    </div>
  </div>
</section>

<% if (pageError) { %>
  <%- include("partials/error", { message: pageError }) %>
<% } %>

<div id="eventList">
  <%- include("./partials/list", { events, session, query: "" }) %>
</div>
