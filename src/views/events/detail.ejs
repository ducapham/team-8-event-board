<div
  id="event-detail-shell"
  class="space-y-6"
  x-data="{ badgeAnimated: false }"
  x-init="$nextTick(() => { badgeAnimated = true; setTimeout(() => { badgeAnimated = false; }, 550); })"
>
  <div class="max-w-3xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-sm p-8">
    <% if (pageError) { %>
      <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        <%= pageError %>
      </div>
    <% } %>

    <% if (!event) { %>
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 text-center text-slate-600">
        <p class="text-lg font-semibold">Event not found</p>
        <p class="mt-2 text-sm">Please return to the event list and try another event.</p>
      </div>
    <% } else { %>
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <p class="text-sm font-semibold text-blue-600 uppercase tracking-wide mb-2">
            Event Detail
          </p>
          <h1 class="text-3xl font-bold text-slate-900"><%= event.title %></h1>
        </div>
        <div
          class="origin-top-right transition duration-300"
          :class="badgeAnimated ? 'scale-110 -rotate-2 shadow-lg' : 'scale-100 rotate-0 shadow-none'"
        >
          <%- include("partials/status-badge", { status: event.status }) %>
        </div>
      </div>

      <div class="space-y-4 text-slate-700">
        <div>
          <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-1">Description</h2>
          <p><%= event.description %></p>
        </div>
      
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-1">Location</h2>
            <p><%= event.location %></p>
          </div>
      
          <div>
            <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-1">Category</h2>
            <p><%= event.category %></p>
          </div>
      
          <div>
            <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-1">Start Time</h2>
            <p><%= event.startDatetime.toLocaleString() %></p>
          </div>
      
          <div>
            <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-1">End Time</h2>
            <p><%= event.endDatetime.toLocaleString() %></p>
          </div>
      
          <% if (event.capacity !== undefined) { %>
            <div>
              <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-1">Capacity</h2>
              <p><%= event.attendees ? event.attendees.length : 0 %>/<%= event.capacity %></p>
            </div>
          <% } %>
      
          <div>
            <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wide mb-1">Organizer</h2>
            <p><%= typeof organizerName !== "undefined" ? organizerName : event.organizerId %></p>
          </div>
        </div>

        <%
          const currentUserId = session?.authenticatedUser?.userId;
          const alreadyAttending =
            currentUserId &&
            event.attendees &&
            event.attendees.some((attendee) => attendee.id === currentUserId);

          const canRsvp =
            currentUserId &&
            event.status === "published" &&
            !alreadyAttending;
        %>

        <% if (canRsvp) { %>
          <div class="mt-6">
            <form
              method="post"
              action="/events/<%= event.id %>/toggle"
              class="m-0"
            >
              <button
                type="submit"
                class="rounded-2xl bg-emerald-600 px-5 py-3 text-white font-semibold hover:bg-emerald-700"
              >
                RSVP
              </button>
            </form>
          </div>
        <% } %>

        <% if (permissions?.canPublish || permissions?.canCancel) { %>
          <div class="mt-6 flex flex-wrap gap-3">
            <% if (permissions.canPublish) { %>
              <form
                method="post"
                action="/events/<%= event.id %>/publish"
                class="m-0"
                hx-post="/events/<%= event.id %>/publish"
                hx-target="#event-detail-shell"
                hx-swap="outerHTML"
              >
                <button type="submit" class="rounded-2xl bg-blue-600 px-5 py-3 text-white font-semibold hover:bg-blue-700">
                  Publish Event
                </button>
              </form>
            <% } %>

            <% if (permissions.canCancel) { %>
              <form
                method="post"
                action="/events/<%= event.id %>/cancel"
                class="m-0"
                hx-post="/events/<%= event.id %>/cancel"
                hx-target="#event-detail-shell"
                hx-swap="outerHTML"
              >
                <button type="submit" class="rounded-2xl bg-red-600 px-5 py-3 text-white font-semibold hover:bg-red-700">
                  Cancel Event
                </button>
              </form>
            <% } %>
          </div>
        <% } %>
      </div>
      <%# Feature 12 — Attendee list: HTMX loads on first click, Alpine controls visibility thereafter %>
      <% if (session?.authenticatedUser && (session.authenticatedUser.role === 'admin' || session.authenticatedUser.userId === event.organizerId)) { %>
        <div x-data="{ open: false }" class="mt-8 border-t border-slate-100 pt-6">
          <button
            type="button"
            class="inline-flex items-center gap-2 rounded-2xl bg-slate-800 px-5 py-2.5 text-sm font-semibold text-white shadow-sm ring-1 ring-slate-900/10 transition-all duration-200 hover:bg-slate-900 hover:shadow active:scale-95"
            hx-get="/events/<%= event.id %>/attendees"
            hx-target="#attendee-list-slot"
            hx-swap="innerHTML"
            hx-trigger="click once"
            @click="open = !open"
            :aria-expanded="open ? 'true' : 'false'"
            aria-controls="attendee-list-slot"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
              <path d="M10 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-7 9a7 7 0 1 1 14 0H3Z" />
            </svg>
            <span x-show="!open">View attendee list</span>
            <span x-show="open" x-cloak>Hide attendee list</span>
            <svg
              xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"
              class="h-4 w-4 transition-transform duration-200"
              :class="open ? 'rotate-180' : ''"
            >
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.06l3.71-3.83a.75.75 0 1 1 1.08 1.04l-4.24 4.38a.75.75 0 0 1-1.08 0L5.21 8.27a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd"/>
            </svg>
          </button>

          <div
            id="attendee-list-slot"
            x-show="open"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 -translate-y-2"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100"
            x-transition:leave-end="opacity-0"
            x-cloak
            class="mt-5"
          >
            <p class="text-sm text-slate-400 italic">Loading attendees…</p>
          </div>
        </div>
      <% } %>
    <% } %>
  </div>

  <%# Feature 13 — Event Comments: loads the comment list via HTMX on page load %>
  <% if (event) { %>
    <div
      class="max-w-3xl mx-auto"
      hx-get="/events/<%= event.id %>/comments"
      hx-trigger="load"
      hx-swap="innerHTML"
    >
      <p class="text-sm text-slate-400 italic">Loading comments…</p>
    </div>
  <% } %>
</div>