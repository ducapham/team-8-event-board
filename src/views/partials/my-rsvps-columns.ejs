<% const dateTimeFormat = { dateStyle: "medium", timeStyle: "short" }; %>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
  <section class="rounded-2xl border border-blue-200 bg-gradient-to-b from-blue-50 to-white p-5 shadow-lg">
    <div class="mb-4 flex items-start justify-between gap-4">
      <div>
        <h2 class="text-xl font-semibold text-slate-900">Upcoming</h2>
        <p class="mt-1 text-sm text-slate-500">
          Events you plan to attend or are currently waitlisted for.
        </p>
      </div>
      <span class="inline-flex whitespace-nowrap rounded-full bg-white/90 px-3 py-1 text-sm font-semibold text-blue-700 shadow-sm">
        <%= upcoming.length %> total
      </span>
    </div>

    <% if (upcoming.length === 0) { %>
      <div class="rounded-xl border border-dashed border-blue-200 bg-white/80 p-5 text-sm text-slate-500">
        You do not have any upcoming RSVPs right now.
      </div>
    <% } else { %>
      <div class="space-y-4">
        <% upcoming.forEach(e => { %>
          <% const isRegistered = e.status === "Registered"; %>
          <% const statusClasses = isRegistered
            ? "bg-emerald-50 text-emerald-700 border-emerald-200"
            : "bg-amber-50 text-amber-700 border-amber-200"; %>

          <article class="rounded-xl border border-blue-100 bg-white p-4 shadow-sm">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-lg font-semibold text-slate-900"><%= e.event.title %></h3>
                  <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-semibold <%= statusClasses %>">
                    <%= e.status %>
                  </span>
                </div>

                <div class="space-y-1 text-sm text-slate-500">
                  <p><strong class="text-slate-700">Location:</strong> <%= e.event.location %></p>
                  <p><strong class="text-slate-700">Starts:</strong> <%= new Date(e.event.startDatetime).toLocaleString(undefined, dateTimeFormat) %></p>
                  <p><strong class="text-slate-700">Ends:</strong> <%= new Date(e.event.endDatetime).toLocaleString(undefined, dateTimeFormat) %></p>
                </div>
              </div>

              <div x-data="{ confirming: false, cancelling: false }" class="shrink-0">
                <template x-if="!confirming">
                  <button
                    type="button"
                    @click="confirming = true"
                    :disabled="cancelling"
                    class="inline-flex items-center justify-center rounded-lg bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-60"
                  >
                    Cancel RSVP
                  </button>
                </template>

                <div
                  x-show="confirming"
                  x-transition
                  class="w-full rounded-xl border border-red-200 bg-red-50 p-3 sm:w-64"
                >
                  <p class="text-sm font-medium text-red-900">Cancel this RSVP?</p>
                  <p class="mt-1 text-xs text-red-700">
                    This will update your dashboard right away.
                  </p>

                  <div class="mt-3 flex gap-2">
                    <button
                      type="button"
                      hx-post="/events/<%= e.event.id %>/toggle?from=my-rsvps&redirectOnSuccess=false"
                      hx-target="#rsvp-columns"
                      hx-swap="innerHTML"
                      @htmx:before-request="cancelling = true"
                      @htmx:after-request="cancelling = false"
                      @htmx:response-error="cancelling = false"
                      :disabled="cancelling"
                      class="inline-flex items-center justify-center rounded-lg bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      <span x-show="!cancelling">Yes, cancel</span>
                      <span x-show="cancelling">Cancelling...</span>
                    </button>

                    <button
                      type="button"
                      @click="confirming = false"
                      :disabled="cancelling"
                      class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      Keep RSVP
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-gradient-to-b from-slate-100 to-white p-5 shadow-lg">
    <div class="mb-4 flex items-start justify-between gap-4">
      <div>
        <h2 class="text-xl font-semibold text-slate-900">Past and Cancelled</h2>
        <p class="mt-1 text-sm text-slate-500">
          Events that already ended or RSVPs you already cancelled.
        </p>
      </div>
      <span class="inline-flex whitespace-nowrap rounded-full bg-white/90 px-3 py-1 text-sm font-semibold text-slate-600 shadow-sm">
        <%= past.length %> total
      </span>
    </div>

    <% if (past.length === 0) { %>
      <div class="rounded-xl border border-dashed border-slate-300 bg-white/80 p-5 text-sm text-slate-500">
        No past or cancelled RSVPs yet.
      </div>
    <% } else { %>
      <div class="space-y-4">
        <% past.forEach(e => { %>
          <% const isCancelled = e.status === "Cancelled"; %>
          <% const isCancelledEvent = e.event.status === "cancelled"; %>
          <% const statusClasses = isCancelled
            ? "bg-rose-50 text-rose-700 border-rose-200"
            : isCancelledEvent
              ? "bg-orange-50 text-orange-700 border-orange-200"
              : "bg-slate-100 text-slate-600 border-slate-200"; %>

          <article class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
            <div class="space-y-2">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-lg font-semibold text-slate-800"><%= e.event.title %></h3>
                <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-xs font-semibold <%= statusClasses %>">
                  <%= isCancelled ? "Cancelled RSVP" : isCancelledEvent ? "Cancelled Event" : "Event Finished" %>
                </span>
              </div>

              <div class="space-y-1 text-sm text-slate-500">
                <p><strong class="text-slate-700">Location:</strong> <%= e.event.location %></p>
                <p><strong class="text-slate-700">Ended:</strong> <%= new Date(e.event.endDatetime).toLocaleString(undefined, dateTimeFormat) %></p>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>
