<section class="space-y-6">
  <div class="rounded-2xl border border-slate-200 bg-gradient-to-b from-white to-slate-50 p-6 shadow-lg">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-slate-900">My RSVPs</h1>
        <p class="mt-2 text-slate-500">
          Track upcoming plans, waitlisted events, and anything that has already passed or been cancelled.
        </p>
      </div>
      <div class="flex flex-wrap gap-2 text-sm">
        <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1.5 font-medium text-emerald-700">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          Registered
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-amber-50 px-3 py-1.5 font-medium text-amber-700">
          <span class="h-2 w-2 rounded-full bg-amber-500"></span>
          Waitlisted
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 font-medium text-slate-600">
          <span class="h-2 w-2 rounded-full bg-slate-400"></span>
          Past or Cancelled
        </span>
      </div>
    </div>
  </div>

  <div id="rsvp-columns">
    <%- include("partials/my-rsvps-columns", { upcoming, past }) %>
  </div>
</section>
