generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  displayName  String
  role         String
  passwordHash String
  attendees    EventAttendee[]
  organized    Event[]         @relation("OrganizerEvents")
}

model Event {
  id           Int             @id @default(autoincrement())
  title        String
  description  String
  location     String
  category     String
  date         DateTime
  time         String
  capacity     Int
  organizerId  String
  organizer    User            @relation("OrganizerEvents", fields: [organizerId], references: [id])
  attendees    EventAttendee[]
}

model EventAttendee {
  id        Int                    @id @default(autoincrement())
  user      User                   @relation(fields: [userId], references: [id])
  userId    String
  event     Event                  @relation(fields: [eventId], references: [id])
  eventId   Int
  status    EventAttendanceStatus  @default(REGISTERED)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  @@unique([userId, eventId])
}

enum EventAttendanceStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}
