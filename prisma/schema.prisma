generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  displayName  String
  role         String
  passwordHash String
  attendees    EventAttendee[]
  organized    Event[]         @relation("OrganizerEvents")
  comments     Comment[]
}

model Event {
  id            Int             @id @default(autoincrement())
  title         String
  description   String
  location      String
  category      String
  date          DateTime
  time          String
  capacity      Int
  organizerId   String
  startDatetime DateTime
  endDatetime  DateTime
  createdAt    DateTime
  updatedAt    DateTime
  status       EventStatus     @default(PUBLISHED)
  organizer    User            @relation("OrganizerEvents", fields: [organizerId], references: [id])
  attendees    EventAttendee[]
  comments     Comment[]
}

model EventAttendee {
  id        Int                   @id @default(autoincrement())
  user      User                  @relation(fields: [userId], references: [id])
  userId    String
  event     Event                 @relation(fields: [eventId], references: [id])
  eventId   Int
  status    EventAttendanceStatus @default(REGISTERED)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @default(now()) @updatedAt

  @@unique([userId, eventId])
}

enum EventAttendanceStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
}

enum EventStatus {
  PUBLISHED
  DRAFT
  CANCELLED
}

// Feature 13 — Event Comments
model Comment {
  id        String   @id @default(cuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  content   String
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}
